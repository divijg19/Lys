{
  "name": "lys",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "rm -rf .next out .velite",
    "clean:all": "rm -rf .next out .velite node_modules bun.lock && bun install",
    "velite": "velite build",
    "dev": "bun velite && concurrently -k -n velite,next -c cyan,magenta \"velite dev\" \"next dev\"",
    "build": "bun clean && bun velite && next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "lint": "biome lint . --write",
    "format": "biome format . --write",
    "type-check": "bun velite && tsc --noEmit --incremental",
    "test": "vitest run",
    "test:ci": "vitest run --coverage --reporter=dot",
    "test:e2e:smoke": "node scripts/e2e-smoke.mjs",
    "qa": "bun type-check && bun lint && bun format && bun test:ci",
    "storybook": "storybook build && storybook dev -p 6006",
    "test:stories": "vitest run --project storybook"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@radix-ui/react-dropdown-menu": "2.1.24",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@radix-ui/react-tooltip": "1.2.16",
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "13.1.1",
    "lucide-react": "1.34.0",
    "next": "16.3.3",
    "next-mdx-remote": "6.0.0",
    "next-themes": "0.4.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-icons": "5.7.0",
    "resend": "6.24.0",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "three": "0.185.1",
    "use-debounce": "10.1.1",
    "velite": "0.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@chromatic-com/storybook": "5.3.0",
    "@next/bundle-analyzer": "16.3.3",
    "@storybook/addon-a11y": "10.5.10",
    "@storybook/addon-docs": "10.5.10",
    "@storybook/addon-links": "10.5.10",
    "@storybook/addon-onboarding": "10.5.10",
    "@storybook/nextjs-vite": "10.5.10",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.2",
    "@types/node": "26.4.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitest/browser": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/ui": "4.1.11",
    "axe-core": "4.13.0",
    "concurrently": "10.0.5",
    "jsdom": "30.0.1",
    "playwright": "1.62.1",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "7.1.0",
    "rehype-slug": "6.0.0",
    "storybook": "10.5.10",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "engines": {
    "bun": ">=1.0.0",
    "node": ">=20.0.0"
  },
  "trustedDependencies": [
    "@tailwindcss/oxide",
    "esbuild",
    "sharp"
  ],
  "volta": {
    "node": "22.20.0"
  }
}
